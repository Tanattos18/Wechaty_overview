{
  "name": "saas-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de chatbot para WhatsApp (Wechaty) com menu, catálogo, pedidos, IA e painel do cliente",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:load": "tsx scripts/load-test.ts",
    "client:import": "tsx scripts/import-catalog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "express": "5.1.0",
    "qrcode": "1.5.4",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
