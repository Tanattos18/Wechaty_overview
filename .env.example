# Porta do painel
PORT=3000

# Marca do painel (nome no login, menu e aba do navegador; cor principal em hexadecimal)
BRAND_NAME=Akylla Bot
BRAND_COLOR=#0f9d7a

# Senha do administrador do SaaS (login com o ID "admin" ou em branco). Mínimo 8 caracteres.
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessão (32+ caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# IA (Claude). Só é usada com a chave preenchida; sem ela o bot responde pela base de conhecimento.
# Chave em https://console.anthropic.com — AI_ENABLED=false desliga mesmo com chave.
AI_ENABLED=true
ANTHROPIC_API_KEY=
# claude-opus-5-5 (padrão, mais capaz) ou claude-haiku-5-5 (bem mais barato para alto volume)
CLAUDE_MODEL=claude-opus-5-5

# WhatsApp (whatsapp-web.js)
# Navegador usado pelo WhatsApp Web (o npm não baixa o Chrome automaticamente)
#   Windows: C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
#   VPS Linux: /usr/bin/google-chrome-stable
BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Conectar automaticamente os bots dos clientes ativos ao iniciar (use true na VPS)
AUTO_START_BOTS=false
# Simular leitura e "digitando…" antes de responder, como um atendente (false = responde na hora)
HUMAN_TYPING=true

# Na VPS, atrás do Nginx com HTTPS:
# TRUST_PROXY=true    usa o IP real do visitante (limite de tentativas de login)
# COOKIE_SECURE=true  o cookie de login só trafega por HTTPS
TRUST_PROXY=false
COOKIE_SECURE=false

# Pasta dos dados (clientes, conversas, pedidos, sessões, base de conhecimento)
DATA_DIR=data
